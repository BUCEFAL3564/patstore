# Порт Express
PORT=3000

# MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/keyhub_api"

# Адреса фронтенда через запятую (пусто = разрешить всё, только для разработки)
CORS_ORIGIN=http://localhost,http://127.0.0.1:5500

# Тестовые пользователи для prisma/seed.js (на проде задать свои пароли)
SEED_ADMIN_EMAIL=admin@keyhub.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_CUSTOMER_EMAIL=customer@keyhub.local
SEED_CUSTOMER_PASSWORD=Customer12345

# JWT: секрет подписи токенов (длинная случайная строка) и срок жизни токена
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Лог SQL-запросов Prisma (пусто = выключен). Пример: PRISMA_LOG=query
PRISMA_LOG=

# Memcached: адрес host:port (пусто = кэш выключен) и TTL кэша каталога в секундах (ТЗ: 60–120)
MEMCACHED_SERVERS=localhost:11211
CACHE_TTL_SECONDS=90

# Docker Compose (docker compose up --build): MySQL в контейнере и порт API на хосте.
# DATABASE_URL и MEMCACHED_SERVERS для контейнера compose собирает сам из этих значений.
# В паролях только буквы и цифры: они подставляются в DATABASE_URL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=keyhub
MYSQL_USER=keyhub
MYSQL_PASSWORD=change-me
APP_PORT=3000
